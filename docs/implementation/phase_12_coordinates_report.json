    "point_bounds": "0 <= x <= width; 0 <= y <= height; centres at column+.5,row+.5",
    "x_formula": "camera.x_origin_mm + camera.x_direction * x * camera.x_mm_per_pixel",
    "encoder_anchor_formula": "transport.y_origin_mm + transport.travel_direction * (count - encoder_origin_count) * mm_per_encoder_count + camera.y_offset_mm",
