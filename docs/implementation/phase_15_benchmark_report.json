  ],
  "semantics": {
    "default_runtime_profiling_enabled": false,
    "public_http_schema_changed": false,
    "database_schema_changed": false,
    "stage_accounting": "Exclusive nested perf_counter_ns spans; preprocessing, segmentation, anomaly, fusion, postprocessing. Sum plus uninstrumented_ms equals total_ms up to floating-point rounding.",
    "total_boundary": "Synchronous InspectionService._inspect_fabric core or caller-owned scheduled callable only. API upload/capture pre-screening/image-info, annotation, storage, SQLite and HTTP overhead excluded.",
    "queue_wait": "Admission to worker acquiring the shared resource gate, excludes rejected-admission retry time; outside total_ms. Zero for synchronous calls.",
    "disabled_branch": "Zero stage_calls means NOT EXECUTED; zero latency does not mean a free model.",
    "error_accounting": "stage_errors counts thrown exceptions only. Handled shadow/fusion failure diagnostic values stay in InspectionResult; a completed callable can be succeeded=true while a branch is degraded.",
    "scheduler": "Explicit opt-in offline callables, bounded FIFO pending queue with up to workers dequeued/in-flight. Full queue raises SchedulerBusy before ownership transfer. No silent drop, no automatic retries.",
    "ordering": "FIFO dequeue only. With multiple workers resource-lock execution/completion order is not guaranteed. Consume futures in source order when required.",
    "resource_gate": "Full-job serialization across default scheduler instances in one Python process; not cross-process, not direct HTTP callers. allow_concurrent_jobs=true explicitly bypasses the gate.",
    "lifecycle": "Graceful drain, queued/pre-start cancellation accounting, running native work not preemptible. shutdown(wait=false) requests drain, not cancellation.",
    "task_ownership": "Caller owns task/model/tensor/context lifetime; never share a SQLAlchemy Session. Do not wait inside a task for another gated task (deadlock).",
    "timing_device": "CPU verified. CUDA path uses device-wide synchronization before/after spans, tested with mocks only; not GPU kernel time or uncontended latency.",
    "service_profile": "Internal InspectionResult.runtime_profile plus best-effort timing-only audit logger when flag enabled. Existing external responses and QC unchanged. If an outer scheduler profiler exists, it owns the complete profile."
  },
