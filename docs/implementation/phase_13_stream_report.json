  "semantics": {
    "camera_lanes": 4,
    "tick": "One synchronized virtual timestamp/count with four RGB rows.",
    "queue_unit": "One atomic bundle of four camera chunks, not one single camera chunk.",
    "backpressure": "Bounded queue plus at most one retained pending bundle. Blocked retries report backpressure and do not read the next source tick.",
    "stop": "stop() halts source acquisition and flushes accepted partial rows; drain take() until terminal stopped/failed. Unacquired configured rows are not reported as delivered.",
    "accounting": "accepted_line_ticks = buffered_line_ticks + pending_line_ticks + queued_line_ticks + delivered_line_ticks. Counts are per synchronized tick, not sum of all four camera rows.",
    "delivery": "take() transfers ownership to the caller, not inference completion or durable acknowledgement.",
    "encoder_range": "Signed 64-bit integer counts, forward counts_per_line > 0; encoder_end_exclusive is first count after last chunk row.",
    "clock": "Explicit timezone-aware origin normalized to UTC + integer microsecond virtual line interval; no wall-clock sleep/FPS claim.",
    "simulation_memory": "Configured nominal RGB payload budget <=64 MiB including queue/pending/builder allowance, not a measured whole-process RSS guarantee."
  },
