FABRIC_APP_NAME="AI Fabric Detect MVP"
FABRIC_APP_ENV=local
FABRIC_DEBUG=true

FABRIC_DATABASE_URL=sqlite:///./storage/app.db

FABRIC_DATA_RAW_DIR=Data/raw
FABRIC_DATA_PROCESSED_DIR=Data/processed
FABRIC_REFERENCE_READY_DIR=Data/processed/reference_ready

FABRIC_STORAGE_DIR=storage
FABRIC_UPLOADS_DIR=storage/uploads
FABRIC_ANNOTATED_DIR=storage/annotated
FABRIC_INDEXES_DIR=storage/indexes
FABRIC_METADATA_DIR=storage/metadata
FABRIC_REFERENCE_REGISTRY_PATH=storage/metadata/reference_registry.json
FABRIC_DEFAULT_REFERENCE_ID=dme_plain_v1

FABRIC_DME_DATASET_DIR=Data/raw/external/20250129_Fabric_defects/Dataset
FABRIC_WFDD_DATASET_DIR=Data/raw/external/WFDD
FABRIC_MVTEC_DATASET_DIR=Data/Test

FABRIC_MODEL_NAME=resnet18
FABRIC_USE_PRETRAINED_WEIGHTS=true
FABRIC_USE_PROJECTION_HEAD=true
FABRIC_PROJECTION_HEAD_PATH=storage/models/projection_head_dme.pt
FABRIC_PROJECTION_DIM=128
FABRIC_DEVICE=auto
FABRIC_IMAGE_MAX_SIZE=768
FABRIC_MODEL_INPUT_SIZE=224
FABRIC_PATCH_SIZE=96
FABRIC_PATCH_STRIDE=48
FABRIC_BATCH_SIZE=16
FABRIC_REFERENCE_MAX_IMAGES=25
FABRIC_ANOMALY_THRESHOLD=0.075
FABRIC_GOOD_AREA_THRESHOLD=0.02
FABRIC_BAD_AREA_THRESHOLD=0.10
FABRIC_MIN_DEFECT_CLUSTER_PATCHES=6
